# Copy to .env and fill in. Only HELM_SECRET is required in production.

# Master key for the credential vault. Generate with: openssl rand -hex 32
# WARNING: changing this makes existing stored API tokens undecryptable.
HELM_SECRET=

# Where the SQLite database and other state live (default: ./data)
HELM_DATA_DIR=./data

# API port (also serves the built UI in production)
PORT=4000

# Background scheduler interval in ms. Set to 0 to disable background work.
HELM_TICK_MS=60000

# User-agent used by the SEO crawler
HELM_USER_AGENT=HelmBot/1.0 (+self-hosted SEO auditor; single-user)

NODE_ENV=production
