# Copy to .env and fill in. Only HELM_SECRET is required in production.

# Master key for the credential vault. Generate with: openssl rand -hex 32
# WARNING: changing this makes existing stored API tokens undecryptable.
HELM_SECRET=

# Where the SQLite database and other state live (default: ./data)
HELM_DATA_DIR=./data

# API port (also serves the built UI in production)
PORT=4000

# Bind address. Defaults to loopback, which is what you want when a tunnel
# (Tailscale, cloudflared) fronts Helm. Set to 0.0.0.0 to serve your LAN.
HELM_HOST=127.0.0.1

# Mark session cookies Secure. Set to 1 ONLY when Helm is reached over HTTPS
# (through a tunnel). Over plain HTTP on a LAN IP this causes a login loop.
# See docs/REMOTE-ACCESS.md
HELM_SECURE_COOKIES=0

# Background scheduler interval in ms. Set to 0 to disable background work.
HELM_TICK_MS=60000

# User-agent used by the SEO crawler
HELM_USER_AGENT=HelmBot/1.0 (+self-hosted SEO auditor; single-user)

NODE_ENV=production

# Absolute base URL Helm is reachable at from outside, e.g.
# https://helm.example.ts.net. Only needed for video: Instagram and TikTok fetch
# attached media themselves, so a render can only be posted to them if its URL
# resolves on the public internet.
# HELM_PUBLIC_URL=
